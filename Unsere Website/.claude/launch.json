{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "static-site",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-c", "import http.server,os,socketserver;p=int(os.environ.get('PORT','4173'));h=http.server.SimpleHTTPRequestHandler;s=socketserver.TCPServer(('',p),h);print('serving on',p);s.serve_forever()"],
      "port": 4173,
      "autoPort": true
    }
  ]
}
